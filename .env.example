# Copy outside this repo/OneDrive: %LOCALAPPDATA%/VintedMCP/.env on Windows.
# Never commit your actual .env or session file. Data defaults to that local directory.
VINTED_MODE=mock
VINTED_BASE_URL=https://www.vinted.it
# Required for HTTP. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_OWNER_SECRET=
MCP_PUBLIC_URL=http://localhost:8000
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Exact trusted HTTPS hosts allowed to deliver ChatGPT photo attachments.
PHOTO_DOWNLOAD_HOSTS=files.oaiusercontent.com
# Explicit opt-in; experimental API, no guarantee against account restrictions.
VINTED_ENABLE_UNOFFICIAL_API=false
